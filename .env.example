# Copy to .env and fill in. .env is gitignored; never commit it.
#
# The repo is public. Scope every key read-only / view-only. Do not grant
# withdrawal or trade permissions on the crypto keys — a leaked withdrawal-
# scoped key is an immediate and irreversible loss, and keys that reach a
# public repo get scraped within minutes.

# Trading 212 — Invest / Stocks ISA only. Read-only scopes.
T212_API_KEY=
T212_API_SECRET=

# Coinbase — CDP API key from the Coinbase Developer Portal (Ed25519 preferred).
# "View" permission only. Paste the private key with literal \n or real newlines.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Coinmate — API key with read-only rights.
COINMATE_CLIENT_ID=
COINMATE_PUBLIC_KEY=
COINMATE_PRIVATE_KEY=

# Optional -------------------------------------------------------------------

# Publish shape only: percentage shares plus an index based at 100, no amounts.
# INDEX_MODE=true
# Base for the index. Set this (as a repo secret) to keep even the base absolute
# figure out of the repo; otherwise data/index_base.json is seeded on first run.
# INDEX_BASE_CZK=

# Reporting currency for the Coinbase row (default EUR).
# COINBASE_QUOTE_CURRENCY=EUR
# Reporting currency for the Degiro row (default EUR).
# DEGIRO_NATIVE_CURRENCY=EUR
# Skip the justETF fallback when Yahoo has no quote.
# DEGIRO_USE_JUSTETF=false
# Print tracebacks for unexpected fetcher errors.
# DEBUG=true
